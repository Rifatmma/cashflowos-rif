# ============================================================
# CashFlowOS — environment variables
# ------------------------------------------------------------
# Copy this file to `.env` (cp .env.example .env), then fill in the values.
# `.env` is gitignored — your real keys never get committed.
#
# THREE COMMON MISTAKES that break everything (avoid them):
#   1) A trailing newline or space in a key. Copy the value EXACTLY, no extra line.
#      (A stray newline is an illegal HTTP header and crashes every request.)
#      Credentials are trimmed on read where we can, but not everywhere.
#   2) Using the /rest/v1 URL. SUPABASE_URL is the BASE project URL
#      (https://xxxx.supabase.co) — NOT https://xxxx.supabase.co/rest/v1.
#   3) Using the anon / publishable key. The app needs the service_role (secret)
#      key. The anon key can't read past security rules → you'll see an empty app.
#
# WHAT HAPPENS IF ONE IS MISSING: nothing crashes. Every integration checks for
# its own keys and the feature simply stays off, with the page saying so. Start
# with the first two blocks; add the rest when you want that feature.
# ============================================================


# ============================================================
# 1. ESSENTIAL — the app will not do anything useful without these
# ============================================================

# ---- Supabase: the database and the photo store ----
# Supabase → Project Settings → Data API → Project URL. Base URL only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase → Project Settings → API Keys → service_role → Reveal & copy.
# This is a SECRET (it bypasses all row security). Server-only — never in a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- The lock on the front door ----
# Any phrase you'll remember. Also the signing secret for guest and staff cookies,
# so changing it signs everyone out. Leave it EMPTY and the app is not gated at all
# (it shows a setup banner instead, so a half-configured clone can't lock you out).
APP_PASSCODE=

# ---- Claude: reading receipts, meal photos and the morning narrative ----
# console.anthropic.com → API keys. Spends credit per receipt photo.
# Without it: Jarvis can't read a bill; everything else still works.
ANTHROPIC_API_KEY=


# ============================================================
# 2. TELEGRAM — Jarvis. Receipts arrive here.
# ============================================================

# From @BotFather after /newbot.
TELEGRAM_BOT_TOKEN=
# Any long random string. Telegram sends it back in a header on every webhook call;
# a request without it is dropped. Set the same value when you register the webhook.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram numeric user ids allowed to talk to the bot privately.
# FAILS CLOSED: empty means nobody. Get yours from @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=
# Your own chat id. Approval cards, the morning brief and the food diary go here.
OWNER_CHAT_ID=
# The staff receipts group(s), comma separated. Group ids are negative.
# THIS IS THE LETTERBOX: any photo posted in these chats is treated as a receipt,
# with no @mention needed. Everything else about the group is ignored.
TELEGRAM_RECEIPT_CHAT_IDS=
# Who gets the morning brief. Falls back to OWNER_CHAT_ID when empty.
TELEGRAM_TEAM_CHAT_IDS=


# ============================================================
# 3. HOW MUCH JARVIS MAY DO ALONE
# ============================================================

# Ringgit. At or under this, a confident receipt from a named shop files itself.
# Over it, you get an Approve / Reject card with the photo attached. Default 200.
EXPENSE_APPROVAL_THRESHOLD=500

# Protects the scheduled jobs (/api/cron-daily, /api/cron-sales-reminder,
# /api/mw-refresh). Vercel sends it as `Authorization: Bearer <value>`.
# Any long random string. FAILS CLOSED: no secret, no cron.
CRON_SECRET=


# ============================================================
# 4. PEOPLE — who may sign in, and to what
# ============================================================

# Moving Walls guests. They sign in with their OWN EMAIL as the passcode and can
# reach /mw and nothing else. Remove an address and that person is out immediately,
# including a cookie already in their browser.
# An email is NOT a secret — this is acceptable only because guests see no money.
GUEST_EMAILS=someone@movingwalls.com, another@movingwalls.com

# Kitchen staff. They reach their own receipts, the stocktake and the waste form —
# never totals, margins, or anyone else's receipts. Format: email=Name, where Name
# must match what Telegram reports, because that is what receipts are tagged with.
STAFF_EMAILS=tina@example.com=Tina Kuno, yuu@example.com=Yuu


# ============================================================
# 5. MOVING WALLS DASHBOARD (/mw) — all optional
# Each one missing just turns off its own section.
# ============================================================

# Google Ads customer id, digits only, no dashes.
GOOGLE_ADS_CUSTOMER_ID=
# GA4 property id, digits only (Admin → Property Settings).
GA4_PROPERTY_ID=
# Search Console property. A URL-prefix property and a domain property are
# DIFFERENT resources with different permissions. Leave empty to auto-discover,
# which is safer — pinning the wrong one gives a 403 that looks like an outage.
GSC_PROPERTY=
# Semrush. NOTE: domain reports need a v3 (legacy) key; a v4 REST token cannot
# read them, whatever the plan page says.
SEMRUSH_API_KEY=

# Composio — the broker for Google Ads, GA4, Search Console, Gmail and Zoho.
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_ACCOUNT=
COMPOSIO_META_ACCOUNT_ID=

# Meta ads.
META_AD_ACCOUNT_ID=
META_SYSTEM_TOKEN=


# ============================================================
# 6. ZOHO CRM — the sales follow-up tab on /mw
# A Self Client from api-console.zoho.com. Read-only scopes only.
# Scopes needed (name tasks, calls and events INDIVIDUALLY — "activities" does
# not cover them):
#   ZohoCRM.modules.leads.READ, ZohoCRM.modules.notes.READ,
#   ZohoCRM.modules.emails.READ, ZohoCRM.modules.deals.READ,
#   ZohoCRM.modules.tasks.READ, ZohoCRM.modules.calls.READ,
#   ZohoCRM.modules.events.READ, ZohoCRM.modules.contacts.READ,
#   ZohoCRM.users.READ, ZohoCRM.settings.modules.READ,
#   ZohoCRM.settings.fields.READ
# ============================================================

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Does not expire. Changing it invalidates the cached access token automatically.
ZOHO_REFRESH_TOKEN=


# ============================================================
# 7. EMAIL — reading payment notifications
# ============================================================

# The inbox Jarvis scans for bank and e-wallet payment alerts, via Composio Gmail.
PAYMENTS_EMAIL=


# ============================================================
# 8. DEPLOYMENT — usually set for you
# ============================================================

# Used to build absolute links in Telegram messages (the "correct it" link).
# Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically; APP_URL overrides it.
# With neither, Jarvis simply sends no link.
APP_URL=

# Which model reads a receipt photo. The first one reads nearly every bill; the
# second runs ONLY when the first cannot, so a printed bill photographed at an
# angle still files instead of being handed back (owner, 9 Oct 2026).
# Defaults are fine; set these only to change model.
VISION_MODEL=
VISION_MODEL_RETRY=
