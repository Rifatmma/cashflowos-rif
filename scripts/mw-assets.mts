// Turn the extracted page vectors into brand assets the app can draw.
//
//   npx -y tsx --conditions=react-server scripts/mw-assets.mts
//
// Writes lib/mw-brand-assets.ts: the MW mark, the triple chevron and one
// unit of the wave, as path data normalised to their own origin, plus the
// colours sampled from the guide's own rendering rather than guessed.
//
// Everything brand-shaped in the Studio was redrawn by eye before this. The
// owner can open the real file in Illustrator, so "close" was never going
// to survive contact. These are the actual curves.

import { readFileSync, writeFileSync } from 'node:fs'
import { createCanvas, loadImage } from '@napi-rs/canvas'

const SVG = 'C:/Users/MOVING WELLS/mw-social/guide2/page10.svg'
const PAGE_PNG = 'C:/Users/MOVING WELLS/mw-social/guide2/p10.png'
const OUT = 'C:/Users/MOVING WELLS/cashflowos-rif/lib/mw-brand-assets.ts'

const svg = readFileSync(SVG, 'utf8')
const paths = new Map<string, string>()
for (const m of svg.matchAll(/<path id="(s\d+)" d="([^"]+)"/g)) paths.set(m[1], m[2])

/** Shift a path so its own bounding box starts at 0,0, and report the size. */
function normalise(d: string) {
  const nums = [...d.matchAll(/-?\d+\.?\d*/g)].map(m => Number(m[0]))
  const xs = nums.filter((_, i) => i % 2 === 0)
  const ys = nums.filter((_, i) => i % 2 === 1)
  const minX = Math.min(...xs), minY = Math.min(...ys)
  const w = Math.max(...xs) - minX, h = Math.max(...ys) - minY
  let i = 0
  const shifted = d.replace(/-?\d+\.?\d*/g, n => {
    const v = Number(n) - (i++ % 2 === 0 ? minX : minY)
    return v.toFixed(2)
  })
  return { d: shifted, w: +w.toFixed(2), h: +h.toFixed(2) }
}

/** Several paths normalised together, keeping their relative positions. */
function normaliseGroup(ids: string[]) {
  const all = ids.map(id => paths.get(id)!).filter(Boolean)
  const nums = all.flatMap(d => [...d.matchAll(/-?\d+\.?\d*/g)].map(m => Number(m[0])))
  const xs = nums.filter((_, i) => i % 2 === 0)
  const ys = nums.filter((_, i) => i % 2 === 1)
  const minX = Math.min(...xs), minY = Math.min(...ys)
  const w = Math.max(...xs) - minX, h = Math.max(...ys) - minY
  const out = all.map(d => {
    let i = 0
    return d.replace(/-?\d+\.?\d*/g, n => (Number(n) - (i++ % 2 === 0 ? minX : minY)).toFixed(2))
  })
  return { ds: out, w: +w.toFixed(2), h: +h.toFixed(2) }
}

const mark = normalise(paths.get('s14')!)
const chevron = normaliseGroup(['s11', 's12', 's13'])
// The band alternates two forms of the same glyph: a filled MW and an
// outline MW. Filled units decode to ~66 path commands, outline ones to
// ~128 because they carry an inner contour as well. s3 and s7 are clipped
// by the page edge and are not usable as tiles.
const wave = normalise(paths.get('s0')!)
const waveOutline = normalise(paths.get('s8')!)

// ── colours, sampled from the guide's own page ─────────────────────────────
//
// The mark is one shape with a gradient across it, so the honest way to get
// its colours is to read them off the rendering at known fractions of its
// width rather than to pick swatches that look about right.
const img = await loadImage(readFileSync(PAGE_PNG))
const c = createCanvas(img.width, img.height)
const ctx = c.getContext('2d')
ctx.drawImage(img, 0, 0)
// p10.png was rendered at scale 1.1 from the same 842x595 viewport.
const S = img.width / 842
const px = (x: number, y: number) => {
  const d = ctx.getImageData(Math.round(x * S), Math.round(y * S), 1, 1).data
  return '#' + [d[0], d[1], d[2]].map(v => v.toString(16).padStart(2, '0')).join('')
}

// Sample along the mark's strokes. y chosen inside the stroke, not the gaps.
const markBox = { x: 236, y: 132, w: 156, h: 60 }
const samples: string[] = []
for (const f of [0.06, 0.3, 0.55, 0.82]) {
  samples.push(px(markBox.x + markBox.w * f, markBox.y + markBox.h * 0.62))
}

const ts = `// GENERATED by scripts/mw-assets.mts — do not edit by hand.
//
// The real brand artwork, read out of the Visual Identity guide's own
// drawing operators. Everything here was previously redrawn by eye; these
// are the actual curves, normalised so each asset starts at its own origin
// and can be scaled to any size.
//
// Draw them with Path2D, which both the browser and @napi-rs/canvas accept:
//
//   const p = new Path2D(MW_MARK.d)
//   ctx.save(); ctx.translate(x, y); ctx.scale(s, s); ctx.fill(p); ctx.restore()

export type BrandPath = { d: string; w: number; h: number }

/** The MW monogram. One shape — its light-to-dark look is a gradient fill. */
export const MW_MARK: BrandPath = {
  w: ${mark.w},
  h: ${mark.h},
  d: '${mark.d}',
}

/** The triple chevron that precedes a heading. Three separate shapes. */
export const MW_CHEVRON: { ds: string[]; w: number; h: number } = {
  w: ${chevron.w},
  h: ${chevron.h},
  ds: [
${chevron.ds.map(d => `    '${d}',`).join('\n')}
  ],
}

/** One repeating unit of the wave band, solid. Tile it horizontally. */
export const MW_WAVE_UNIT: BrandPath = {
  w: ${wave.w},
  h: ${wave.h},
  d: '${wave.d}',
}

/**
 * The same unit as an outline. The guide alternates filled and outline
 * along a band; using only one of them is what made the first version read
 * as a plain zigzag rather than as the brand's own pattern.
 */
export const MW_WAVE_OUTLINE: BrandPath = {
  w: ${waveOutline.w},
  h: ${waveOutline.h},
  d: '${waveOutline.d}',
}

/**
 * The mark's gradient, sampled across its own width in the guide rather
 * than chosen from a swatch page.
 */
export const MARK_STOPS = ${JSON.stringify(samples)} as const
`

writeFileSync(OUT, ts)
console.log('mark', mark.w, 'x', mark.h, '| chevron', chevron.w, 'x', chevron.h, '| wave', wave.w, 'x', wave.h)
console.log('sampled mark colours:', samples)
