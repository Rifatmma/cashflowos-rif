// Pull the connection-dots constellation out of page 19.
//   npx -y tsx --conditions=react-server scripts/dots-extract.mts
//
// The page holds 4,830 vector paths — four tiles of a dense node network.
// Shipping that as a blob would give a fixed-size, unanimatable picture, so
// what is taken is the STRUCTURE: where the nodes are and how big. Edges
// are then rebuilt by proximity, which is how a graphic like this is made
// in the first place, and means it can be drawn at any size, in any brand
// colour, with nodes that drift and lines that draw themselves.
//
// Real positions rather than random ones, because the density and the
// clustering are what make it read as the brand's own pattern.

import { getDocument, OPS } from 'pdfjs-dist/legacy/build/pdf.mjs'
import { readFileSync, writeFileSync } from 'node:fs'

type M = [number, number, number, number, number, number]
const mul = (a: M, b: M): M => [
  a[0] * b[0] + a[2] * b[1], a[1] * b[0] + a[3] * b[1],
  a[0] * b[2] + a[2] * b[3], a[1] * b[2] + a[3] * b[3],
  a[0] * b[4] + a[2] * b[5] + a[4], a[1] * b[4] + a[3] * b[5] + a[5],
]
const apply = (m: M, x: number, y: number): [number, number] =>
  [m[0] * x + m[2] * y + m[4], m[1] * x + m[3] * y + m[5]]

const doc = await getDocument({
  data: new Uint8Array(readFileSync('C:/Users/MOVING WELLS/Downloads/Moving Wall Visual guide book-compressed (2).pdf')),
}).promise
const page = await doc.getPage(19)
const vp = page.getViewport({ scale: 1 })
const ol = await page.getOperatorList()

const base = vp.transform as unknown as M
let ctm: M = [...base] as M
const stack: M[] = []

type Blob2 = { cx: number; cy: number; r: number; pts: number; aspect: number }
const blobs: Blob2[] = []

for (let i = 0; i < ol.fnArray.length; i++) {
  const op = ol.fnArray[i]
  const a = ol.argsArray[i] as any
  if (op === OPS.save) stack.push([...ctm] as M)
  else if (op === OPS.restore) ctm = (stack.pop() ?? [...base]) as M
  else if (op === OPS.transform) ctm = mul(ctm, a as M)
  else if (op === OPS.constructPath) {
    for (const sp of a[1] as Float32Array[]) {
      const xs: number[] = [], ys: number[] = []
      let k = 0
      const n = sp.length
      let cmds = 0
      while (k < n) {
        const code = sp[k++]
        const take = code === 0 || code === 1 ? 1 : code === 2 ? 3 : code === 3 ? 2 : -1
        if (take < 0) break
        cmds++
        for (let t = 0; t < take; t++) {
          const [px, py] = apply(ctm, sp[k++], sp[k++])
          xs.push(px); ys.push(py)
        }
      }
      if (!xs.length) continue
      const minX = Math.min(...xs), maxX = Math.max(...xs)
      const minY = Math.min(...ys), maxY = Math.max(...ys)
      const w = maxX - minX, h = maxY - minY
      // Aspect matters: a circle is square-ish, a line fragment is not.
      // Without this the "nodes" include bits of the mesh's own edges, and
      // the result clumps into strings instead of an even field.
      const aspect = w > 0 && h > 0 ? Math.min(w, h) / Math.max(w, h) : 0
      blobs.push({ cx: (minX + maxX) / 2, cy: (minY + maxY) / 2, r: Math.max(w, h) / 2, pts: cmds, aspect })
    }
  }
}

// A node is a small, roughly square shape — a circle. Lines are long and
// thin, and get rebuilt by proximity rather than captured.
// A circle drawn as beziers is 4 or 5 commands and nearly square.
const dots = blobs.filter(b => b.r > 0.4 && b.r < 9 && b.pts >= 3 && b.pts <= 6 && b.aspect > 0.72)
console.log('paths', blobs.length, '→ dot-like', dots.length)

// The four tiles sit side by side. Take the densest one and normalise it to
// a unit square so it can be drawn at any size.
const xs = dots.map(d => d.cx)
const minX = Math.min(...xs), maxX = Math.max(...xs)
const tileW = (maxX - minX) / 4
const tiles = [0, 1, 2, 3].map(t =>
  dots.filter(d => d.cx >= minX + t * tileW && d.cx < minX + (t + 1) * tileW))
tiles.forEach((t, i) => console.log(`  tile ${i}: ${t.length} nodes`))
const tile = tiles.reduce((a, b) => (b.length > a.length ? b : a))

const tx = tile.map(d => d.cx), ty = tile.map(d => d.cy)
const x0 = Math.min(...tx), x1 = Math.max(...tx)
const y0 = Math.min(...ty), y1 = Math.max(...ty)
const rs = tile.map(d => d.r)
const rMax = Math.max(...rs)

const nodes = tile.map(d => ({
  x: +((d.cx - x0) / (x1 - x0)).toFixed(4),
  y: +((d.cy - y0) / (y1 - y0)).toFixed(4),
  r: +(d.r / rMax).toFixed(3),
}))

const ts = `// GENERATED by scripts/dots-extract.mts — do not edit by hand.
//
// The Connection Dots constellation, taken from page 19 of the Visual
// Identity guide. The guide's own page draws this as 4,830 fixed vector
// paths; what is kept here is where the nodes ARE, normalised to a unit
// square, so the pattern can be drawn at any size, tinted any brand
// colour, and animated — nodes drifting, edges drawing themselves in.
//
// Edges are not stored. They are rebuilt by proximity at draw time, which
// is how this kind of graphic is constructed anyway and means the mesh
// stays correct when nodes move.
//
//   "The use of interconnected nodes visually represents collaboration and
//    partnerships, reinforcing the role as a trusted transformation
//    partner."                         — Visual Identity Guidelines, p19

export type DotNode = { x: number; y: number; r: number }

/** ${nodes.length} nodes, x and y in 0..1, r relative to the largest. */
export const MW_DOTS: DotNode[] = ${JSON.stringify(nodes)}
`
writeFileSync('C:/Users/MOVING WELLS/cashflowos-rif/lib/mw-brand-dots.ts', ts)
console.log('kept', nodes.length, 'nodes')
